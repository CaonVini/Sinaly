# Copie para .env (local) ou .env.staging (servidor) e troque TODOS os segredos.
NODE_ENV=staging
POSTGRES_USER=sinaly
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sinaly
# Dentro do Docker o host do banco é "postgres". Fora do Docker, use localhost:5432.
DATABASE_URL=postgres://sinaly:troque-esta-senha@postgres:5432/sinaly
API_PORT=3333
CORS_ORIGINS=http://localhost:3000
# true quando a API está atrás de Caddy/Nginx (para o limite de requisições ver o IP real)
TRUST_PROXY=false
# Segredos da API: gere cada um com o comando indicado. NUNCA reutilize entre ambientes.
JWT_SECRET=gere-com-openssl-rand-base64-48
CPF_HASH_PEPPER=gere-com-openssl-rand-base64-48
# 32 bytes em base64: openssl rand -base64 32. Perder esta chave = perder os CPFs cifrados.
DATA_ENCRYPTION_KEY=gere-com-openssl-rand-base64-32
MINIO_ROOT_USER=sinaly-minio
MINIO_ROOT_PASSWORD=troque-esta-senha-longa
# Portas expostas no host. Em servidor público deixe o banco e o MinIO só em 127.0.0.1.
BIND_ADDR=127.0.0.1
# Painel da prefeitura (Next.js). Em produção use https e COOKIE_SECURE=true.
PAINEL_PORT=3000
PAINEL_URL=http://localhost:3000
COOKIE_SECURE=false
# Bairro automático (geocodificação reversa pelo ponto no mapa). O compose liga por padrão.
# O Nominatim público é só para demo (1 consulta/s). Em produção use um geocoder próprio ou pago (GEOCODER_URL).
GEOCODER_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=Sinaly-MVP/0.1 (contato@suaprefeitura.gov.br)
# Área de atuação inicial ("Nome|oeste,sul,leste,norte"). O admin troca em Configuração → Área de atuação.
SERVICE_AREA_DEFAULT=Concórdia (SC)|-52.35,-27.48,-51.78,-27.00
